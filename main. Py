        self._collect()
        self.on_save(dict(self._s))
        self._status_text.value = "âœ“ طھظ… طظپط¸ ط§ظ„ط¥ط¹ط¯ط§ط¯ط§طھ ط¨ظ†ط¬ط§ط”
        لون نص الحالة = أخضر
