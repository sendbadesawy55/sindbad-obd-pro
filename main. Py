    """يقرأ بيانات المستشعر في سلسلة عمليات خلفية."""

    def __init__(self, on_data, on_dtcs, on_disconnect):
        self._on_data = on_data
        self._on_dtcs = on_dtcs
        self._on_disconnect = on_disconnect
        self._thread: Optional[threading.Thread] = None
        self._running = False
        self._conn = None
        self._sim = {"rpm": 850, "temp": 88, "throttle": 5,
                     "السرعة": 0، "البطارية": 13.8}

    def start(self, settings: dict):
        self._settings = settings
        self._running = True
        self._thread = threading.Thread(target=self._run, daemon=True)
        self._thread.start()

    def stop(self):
        self._running = False
        إذا كان self._conn:
            حاول: self._conn.close()
            باستثناء الاستثناء: تمرير
            self._conn = None

    def test_connection(self, settings: dict, callback):
        """اختبار لمرة واحدة في سلسلة عمليات خلفية."""
        def _test():
            إذا كانت الإعدادات["نوع_الاتصال"] تساوي "محاكاة":
                رد الاتصال(صحيح، "œ“ ظˆط¶ط¹ ط§ظ„ظ…طط§ظƒط§ط© ظٹط¹ظ…ظ„ ط¯ط§ط¦ظ…ط§ظ‹”)
                يعود
            إذا لم يكن OBD_AVAILABLE:
                رد اتصال (خطأ، "âœ— ظ…ظƒطھط¨ط© obd ط؛ظٹط± ظ…ط«ط¨طھ©»)
                يعود
            يحاول:
                port = build_port_string(settings)
                conn = obd.OBD(portstr=port or None, fast=False, timeout=5)
                إذا كان الاتصال موجودًا:
                    callback(True, f"âœ“ ط§طھطµط§ظ„ ظ†ط§ط¬ط: {conn.port_name()}")
                آخر:
                    رد الاتصال(خطأ، "œ— طھط¹ط°ظ'ط± ط§ظ„ط§طھطμط§ظ„ âœ— طھطظ‚ظ‚ ظ…ظ† ط§ظ„ط¥ط¹ط¯ط§ط¯ط§طھ”)
                conn.close()
            باستثناء الاستثناء كما يلي:
                رد الاتصال (False، f"âœ— ط®ط·ط £: {exc}")
        threading.Thread(target=_test, daemon=True).start()

    def _run(self):
        إذا كان self._settings.get("connection_type") == "simulation":
            self._run_simulation()
        آخر:
            self._run_device()

    def _run_simulation(self):
        targets = dict(self._sim)
        أثناء تشغيل self._running:
            targets.update({"rpm": random.uniform(600, 7200),
                            "temp": random.uniform(75, 108),
                            "throttle": random.uniform(0, 90),
                            "السرعة": عشوائي.موحد(0، 180)،
                            "البطارية": عشوائي.موحد(11.5، 15.0)})
            for _ in range(8):
                إذا لم يكن self._running: توقف
                for k in self._sim:
                    self._sim[k] = lerp(self._sim[k], targets[k], 0.15)
                self._on_data(dict(self._sim))
                time.sleep(0.2)

    def _run_device(self):
